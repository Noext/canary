FROM node:22.23.3-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS build
WORKDIR /app
RUN corepack enable
ENV HUSKY=0
COPY . .
RUN corepack pnpm install --frozen-lockfile \
    && corepack pnpm --filter @usecanary/pr-qa... build

FROM node:22.23.3-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
ENV NODE_ENV=production PLAYWRIGHT_BROWSERS_PATH=/ms-playwright QA_DATA_DIR=/data QA_HOST=0.0.0.0
WORKDIR /app
COPY --from=build /app/apps/canary/dist /app/apps/canary/dist
COPY --from=build /app/apps/canary-pr-qa/dist /app/apps/canary-pr-qa/dist
COPY --from=build /app/apps/canary/package.json /app/apps/canary/package.json
COPY --from=build /app/apps/canary-pr-qa/package.json /app/apps/canary-pr-qa/package.json
# Same image supports separate API, worker and isolated browser roles.
RUN npx --yes playwright@1.58.2 install-deps chromium \
    && mkdir -p /data /ms-playwright /home/node/.canary/sessions \
    && chown -R node:node /data /ms-playwright /home/node/.canary \
    && ln -s /app/apps/canary-pr-qa/dist/cli.js /usr/local/bin/canary-pr-qa
USER node
RUN node /app/apps/canary/dist/cli.js install
EXPOSE 8787
ENTRYPOINT ["node", "/app/apps/canary-pr-qa/dist/cli.js"]
CMD ["serve"]
