# GitHub fine-grained PAT: Contents/Metadata/Deployments read, Pull requests write,
# Commit statuses write, restricted to the repositories you want to QA.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_ALLOWED_REPOS=Noext/canary

# Any endpoint implementing POST /chat/completions. Include /v1 if your endpoint needs it.
OPENAI_BASE_URL=http://host.docker.internal:8317/v1
OPENAI_API_KEY=
OPENAI_MODEL=your-model-name
OPENAI_JSON_MODE=true
# Some reasoning endpoints require max_completion_tokens instead of max_tokens.
OPENAI_TOKEN_PARAMETER=max_tokens
# Empty: use the provider's default (compatible with models that reject temperature).
OPENAI_TEMPERATURE=

# Preview host:port allowlist (exact matches, no wildcards). Add every preview host you use.
PREVIEW_ALLOWED_HOSTS=preview.example.com
# Leave empty to resolve a successful GitHub deployment for the exact PR SHA.
PREVIEW_URL_TEMPLATE=
PREVIEW_ENVIRONMENT=preview
# Explicit --preview or template requires an x-commit-sha header, or JSON {"sha":"<40-char SHA>"}.
PREVIEW_SHA_HEADER=x-commit-sha
PREVIEW_SHA_PATH=

# Generate with openssl rand -hex 32. The service refuses example placeholders.
QA_API_TOKEN=
QA_DATA_DIR=./qa-data
QA_HOST=127.0.0.1
QA_PORT=8787
QA_MAX_SCENARIOS=8
QA_MAX_STEPS=25
QA_PLAN_MAX_TOKENS=8000
QA_ACTION_MAX_TOKENS=4096
QA_DOCTOR_MAX_TOKENS=1024
QA_STEP_TIMEOUT_SECONDS=30
QA_MODEL_TIMEOUT_SECONDS=120
QA_CONTEXT_CHARS=120000
CANARY_LOG_LEVEL=info

# Public origin of this service (no /artifacts suffix), e.g. https://qa.example.com
ARTIFACT_BASE_URL=
# false: reports require the same bearer auth as the API. true: random UUID links are readable.
# Artifacts may contain screenshots, cookies in HAR/traces and test data. Choose deliberately.
ARTIFACT_PUBLIC=false

# Optional override for a separately built Canary CLI. Normally inferred from the monorepo.
# CANARY_CLI_PATH=/absolute/path/to/apps/canary/dist/cli.js

# Optional, only if your development environment disallows Unix sockets.
# Default daemon transport stays Unix sockets (Windows: named pipes).
# CANARY_DAEMON_PORT=18473
# CANARY_DAEMON_TOKEN=replace-with-at-least-32-random-characters

# Durable production queue: generate three DIFFERENT random hex secrets (openssl rand -hex 32).
# Keep QA_DB_PASSWORD URL-safe (hex); DATABASE_URL is assembled by Compose.
QA_DB_PASSWORD=
QA_BROWSER_SERVICE_TOKEN=
DATABASE_URL=
QA_RUN_TIMEOUT_SECONDS=900
QA_RUN_MAX_TOKENS=100000
QA_RUN_MAX_COST_USD=10
# Set actual provider rates for cost estimates/budgets. Token budgets remain enforced independently.
QA_INPUT_COST_PER_MILLION=0
QA_OUTPUT_COST_PER_MILLION=0
QA_PREVIEW_WAIT_SECONDS=900
QA_ALLOW_PRIVATE_PREVIEWS=false
QA_BASELINE_URL_TEMPLATE=
# Mounted read-only config directory. Keep private keys/users/fixtures out of Git.
QA_USERS_FILE=
QA_FIXTURES_FILE=
QA_OIDC_ISSUER=
QA_OIDC_AUDIENCE=
QA_OIDC_JWKS_URL=
# Optional GitHub App, alternative to GITHUB_TOKEN. Checks:write required in addition to PAT permissions.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
# Data governance: exact provider hosts, e.g. api.openai.com (or your own endpoint).
QA_ALLOWED_PROVIDER_HOSTS=
QA_RETENTION_DAYS=14
QA_STORAGE_MAX_GB=20
QA_RAW_EVIDENCE=false
# Optional OTLP collector URL, e.g. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=canary-pr-qa
QA_IMAGE=canary-pr-qa:local
