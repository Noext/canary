# GitHub is connected from the admin dashboard: create your App, install it,
# select repositories. No PAT or App credentials required for the Compose service.
# Optional server restriction: empty lets the admin select installed repositories.
GITHUB_ALLOWED_REPOS=
GITHUB_API_URL=https://api.github.com
# Legacy technical access only (not needed with the dashboard App).
GITHUB_TOKEN=

# Any endpoint implementing POST /chat/completions. Include /v1 if your endpoint needs it.
OPENAI_BASE_URL=https://ai.noext.fr/v1
OPENAI_API_KEY=
OPENAI_MODEL=opencode-go/deepseek-v4.1-flash
# Empty: list all provider models. Otherwise allow only these exact model IDs.
QA_ALLOWED_MODELS=
OPENAI_JSON_MODE=true
# Some reasoning endpoints require max_completion_tokens instead of max_tokens.
OPENAI_TOKEN_PARAMETER=max_tokens
# Empty: use the provider's default (compatible with models that reject temperature).
OPENAI_TEMPERATURE=
# Streamed by default: a proxy in front of the endpoint cuts an unstreamed response (~100 s),
# before a long plan is finished. Set false for an endpoint that cannot stream.
OPENAI_STREAM=true
# Caps the model's reasoning on endpoints that accept it (minimal|low|medium|high). A reasoning
# model can spend its whole output budget on reasoning and return no JSON content at all.
OPENAI_REASONING_EFFORT=

# Preview host:port allowlist (exact matches, plus `*.domain` for its subdomains).
# A wildcard must name a domain you control: a shared public suffix (`*.com`,
# `*.co.uk`, `*.github.io`) is refused. `*.example.com:443` also covers
# `https://api.example.com`, because the scheme already implies that port.
# This is the initial default: the administrator edits the list in the dashboard
# (Réglages), where the saved list wins and is published to the browser and egress
# services through QA_POLICY_DIR (Compose mounts the qa-policy volume at /policy).
# Add every preview host you use.
PREVIEW_ALLOWED_HOSTS=preview.example.com
# Leave empty to resolve a successful GitHub deployment for the exact PR SHA.
PREVIEW_URL_TEMPLATE=
PREVIEW_ENVIRONMENT=preview
# Explicit --preview or template requires an x-commit-sha header, or JSON {"sha":"<40-char SHA>"}.
PREVIEW_SHA_HEADER=x-commit-sha
PREVIEW_SHA_PATH=

# Generate with openssl rand -hex 32. The service refuses example placeholders.
QA_API_TOKEN=
QA_DATA_DIR=./qa-data
QA_HOST=127.0.0.1
QA_PORT=8787
QA_MAX_SCENARIOS=8
QA_MAX_STEPS=25
QA_PLAN_MAX_TOKENS=8000
QA_DOCTOR_MAX_TOKENS=1024
# Output ceiling for ONE model call, in tokens (default 32768). It is not the
# plan bound: the value actually sent to the provider is the smaller of this and
# the call's own bound (QA_PLAN_MAX_TOKENS, QA_DOCTOR_MAX_TOKENS), and a response
# that reports more output tokens than that bound is treated as an unusable
# generation (MODEL_OUTPUT_INCOMPLETE), so the single replay applies and the run
# is not lost to the total budget. Lower it to tighten one call; raise it only
# deliberately, and never to keep a provider that ignores the limit happy.
# 0 is refused (config error), not read as "no ceiling": a single unbounded call
# is what exhausted a run's whole envelope once. A run's total budget
# (QA_RUN_MAX_TOKENS, QA_RUN_MAX_COST_USD) is unchanged and still applied on top.
QA_CALL_MAX_TOKENS=32768
QA_STEP_TIMEOUT_SECONDS=30
QA_MODEL_TIMEOUT_SECONDS=120
# Reprises d'un appel modèle coupé par le transport (reset, timeout, socket
# fermée), avec 1 s / 4 s / 10 s entre les essais. 0 désactive le repli ; une
# réponse reçue mais inexploitable (MODEL_OUTPUT_INCOMPLETE, MODEL_JSON_INVALID)
# dispose en plus d'une reprise unique, bornée par cette même variable, et son
# extrait borné (500 caractères, position d'arrêt comprise) reste dans le
# diagnostic. Un plafond absolu de 10 appels modèle par run borne la dépense.
# Chaque tentative n'est lancée que si l'enveloppe de tokens/coût couvre son pire
# cas en plus de l'usage consommé et des réserves : c'est une borne DURE, un appel
# qui ne tient pas dedans n'est jamais envoyé. Une tentative perdue est créditée
# de ce que le transport a réellement livré (usage partiel du flux, ou texte
# reçu), plafonnée par le pire cas de cette tentative, chiffrée à part dans
# usage.reservedTokens/reservedCostUsd ; cette réserve est jugée avec l'usage
# consommé à l'admission suivante, qui refuse d'envoyer ce qui ne tient plus.
# Repli sur la borne théorique (sortie maximale) seulement si la coupure n'a rien
# laissé observer de crédible : aucun octet reçu, ou un usage annoncé dont tous
# les compteurs sont nuls — un zéro annoncé n'est pas une mesure, il ne peut donc
# ni créditer une réserve nulle, ni faire déclarer zéro pour un prompt envoyé.
# Un total_tokens rapporté par l'endpoint est une mesure, jamais une estimation
# à corriger : il chiffre l'appel à sa hauteur — usage consommé sur une réponse,
# réserve sur une tentative perdue — même quand prompt_tokens et
# completion_tokens sont absents ou nuls, et il échappe au plafond du pire cas
# admis. Une réponse qui annonce plus que l'enveloppe est donc déclarée telle
# quelle (usage.tokens, ou usage.reservedTokens/reservedCostUsd sur une tentative
# perdue) et les admissions suivantes sont refusées : aucune requête de plus ne
# part, y compris sur une reprise déjà décidée.
# L'entrée d'un appel est bornée à deux octets par token, plus 64 tokens par
# message, et jamais sous le plus grand chiffre d'entrée déjà rapporté sur le run
# (prompt_tokens, ou total_tokens quand ce total est plus lourd) : une
# sous-estimation connue ne décide pas deux admissions. Marge assumée : la
# première réponse qui annonce une entrée plus lourde que cette borne n'est
# découverte qu'après son envoi — elle est alors déclarée dans usage, aucun appel
# suivant n'est décidé sous la borne basse, et le plancher observé porte les
# admissions suivantes. Angle mort assumé : des tokens générés mais jamais
# transmis ne sont pas comptés, l'enveloppe borne ce qu'on peut observer, pas ce
# que l'endpoint a pu facturer ; et une tentative perdue qui n'annonce que des
# compteurs séparés, sans total_tokens, reste plafonnée au pire cas admis de cet
# appel. Les jauges durables (/metrics) comptent usage consommé + réserve, jamais
# l'un sans l'autre.
QA_MODEL_RETRIES=3
QA_CONTEXT_CHARS=120000
CANARY_LOG_LEVEL=info

# Public origin of this service (no /artifacts suffix), e.g. https://qa.example.com
ARTIFACT_BASE_URL=
# Legacy file server only: production SQL ignores ARTIFACT_PUBLIC.
# Production reports require project authentication or an explicit short-lived signed link.
# Artifacts may contain screenshots, cookies in HAR/traces and test data. Choose deliberately.
ARTIFACT_PUBLIC=false

# Optional override for a separately built Canary CLI. Normally inferred from the monorepo.
# CANARY_CLI_PATH=/absolute/path/to/apps/canary/dist/cli.js

# Optional, only if your development environment disallows Unix sockets.
# Default daemon transport stays Unix sockets (Windows: named pipes).
# CANARY_DAEMON_PORT=18473
# CANARY_DAEMON_TOKEN=replace-with-at-least-32-random-characters

# Durable production queue: generate three DIFFERENT random hex secrets (openssl rand -hex 32).
# Keep QA_DB_PASSWORD URL-safe (hex); DATABASE_URL is assembled by Compose.
QA_DB_PASSWORD=
QA_BROWSER_SERVICE_TOKEN=
DATABASE_URL=
QA_RUN_TIMEOUT_SECONDS=900
QA_RUN_MAX_TOKENS=100000
QA_RUN_MAX_COST_USD=10
# Set actual provider rates for cost estimates/budgets. Token budgets remain enforced independently.
QA_INPUT_COST_PER_MILLION=0
QA_OUTPUT_COST_PER_MILLION=0
# Manual/legacy path only: how long a submitted run waits for an exact-commit preview.
QA_PREVIEW_WAIT_SECONDS=900
# Automatic runs: a non-draft PR event on a connected, opted-in repository runs without an operator.
# false keeps recording attempts as auto_disabled (audit automatic.disabled) without running.
QA_AUTO_RUNS=true
# Automatic preview wait (60-86400 s) with probe backoff 30/60/120/300 s.
# Past the deadline the attempt becomes expired and is never replayed automatically.
QA_AUTO_PREVIEW_WAIT_SECONDS=1800
QA_ALLOW_PRIVATE_PREVIEWS=false
# Policy directory shared with the browser and egress services (Compose: /policy).
# Leave empty outside Compose to keep the environment list only.
QA_POLICY_DIR=
QA_BASELINE_URL_TEMPLATE=
# Mounted read-only config directory. Keep private keys/users/fixtures out of Git.
QA_USERS_FILE=
QA_FIXTURES_FILE=
QA_OIDC_ISSUER=
QA_OIDC_AUDIENCE=
QA_OIDC_JWKS_URL=
# Legacy manually provisioned App. Leave empty when using dashboard onboarding.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
# Durable automatic-run limits, across all workers; explicit dashboard reruns stay available.
QA_WEBHOOK_MAX_RUNS_PER_HOUR=60
QA_WEBHOOK_REPO_MAX_RUNS_PER_HOUR=20
# Data governance: exact provider hosts, e.g. api.openai.com (or your own endpoint).
QA_ALLOWED_PROVIDER_HOSTS=
QA_RETENTION_DAYS=14
QA_STORAGE_MAX_GB=20
# Raw dumps only (trace.zip, HAR, console.log, results.json). Reports, videos and
# images are always served to users authorized on the run's repository.
QA_RAW_EVIDENCE=false
# Optional OTLP collector URL, e.g. http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=canary-pr-qa
QA_IMAGE=canary-pr-qa:local
