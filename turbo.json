{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "CANARY_CI_JOB",
    "PLAYWRIGHT_BROWSERS_PATH",
    "TMPDIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "assets/viewer-bundle.js",
        "assets/viewer-bundle.css",
        "assets/recorder-adapter.bundle.js",
        "src/assets/embedded.generated.ts",
        ".astro/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "outputs": ["coverage/**"],
      "env": [
        "CANARY_TEST_TCP",
        "CANARY_DAEMON_PORT",
        "CANARY_DAEMON_TOKEN",
        "QA_TEST_DATABASE_URL",
        "NODE_USE_ENV_PROXY"
      ],
      "cache": false
    },
    "compile": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
