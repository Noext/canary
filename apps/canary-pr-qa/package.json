{
  "name": "@usecanary/pr-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous PR QA using Canary's existing Chromium sessions and evidence pipeline",
  "bin": {
    "canary-pr-qa": "./dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "compile": "tsc --noEmit",
    "test": "vitest run --exclude test/e2e.test.ts",
    "test:e2e": "vitest run test/e2e.test.ts",
    "dev": "tsx src/cli.ts",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@usecanary/cli": "workspace:*",
    "@usecanary/logger": "workspace:*",
    "@usecanary/protocol": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@usecanary/config": "workspace:*",
    "@types/node": "^24.0.0",
    "esbuild": "^0.27.4",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  }
}
