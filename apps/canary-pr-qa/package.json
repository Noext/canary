{
  "name": "@usecanary/pr-qa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "description": "Autonomous PR QA using Canary's existing Chromium sessions and evidence pipeline",
  "bin": {
    "canary-pr-qa": "./dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "compile": "tsc --noEmit",
    "test": "vitest run --exclude test/e2e.test.ts --exclude test/container.test.ts",
    "test:e2e": "vitest run test/e2e.test.ts",
    "test:container": "vitest run test/container.test.ts",
    "dev": "node scripts/dev.mjs",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@usecanary/cli": "workspace:*",
    "@usecanary/logger": "workspace:*",
    "@usecanary/pr-qa-ui": "workspace:*",
    "@usecanary/protocol": "workspace:*",
    "jose": "6.1.3",
    "pg": "8.16.3",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "prom-client": "15.1.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@electric-sql/pglite-socket": "0.0.19",
    "@types/node": "^24.0.0",
    "@types/pg": "8.15.5",
    "@types/pngjs": "6.0.5",
    "@usecanary/config": "workspace:*",
    "esbuild": "^0.27.4",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  }
}
